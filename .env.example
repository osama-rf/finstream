NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Gemini AI — get from Google AI Studio
GEMINI_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# SingleView Open Banking API — get from onesingleview.com
OSV_BASE_URL=https://api.onesingleview.com
OSV_CLIENT_ID=your_client_id
OSV_CLIENT_CODE=your_client_code
OSV_MERCHANT_ID=your_merchant_id

# App URL (used for OAuth callback)
NEXT_PUBLIC_APP_URL=http://localhost:3000
